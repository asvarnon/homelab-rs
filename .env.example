# Copy this file to .env and fill in real values. .env is gitignored.

# Cloudflare Access / Zero Trust — JWT verification config
# Certs (JWKS) endpoint: https://<your-team>.cloudflareaccess.com/cdn-cgi/access/certs
CF_CERTS_URL=https://<your-team>.cloudflareaccess.com/cdn-cgi/access/certs
CF_AUD=<access-application-audience-tag>

# Deployment profile — "local" skips Cloudflare Access JWT validation in require_cf_jwt
PROFILE=local

# Public hostname this server is reached at through the Cloudflare Tunnel
# (added to rmcp's Host-header allowlist alongside localhost/127.0.0.1/::1).
# Only needed in production — local dev traffic arrives over loopback already.
MCP_PUBLIC_HOST=<your-public-tunnel-hostname>

# Proxmox API token (used by HomelabClient to reach the cluster)
PROXMOX_TOKEN_ID=<user@realm!token-name>
PROXMOX_TOKEN_SECRET=<token-secret>

# OPNsense API key/secret (sent as HTTP Basic auth — key is username, secret is password)
OPNSENSE_API_KEY=<api-key>
OPNSENSE_API_SECRET=<api-secret>

# Cloudflare Access service token — used by Claude Code (.mcp.json headers) to authenticate
# against the Cloudflare Tunnel without an interactive browser login.
# Generate in Zero Trust → Access → Service Auth → Service Tokens.
CF_MCP_CLIENT_ID=<service-token-client-id>
CF_MCP_CLIENT_SECRET=<service-token-client-secret>
